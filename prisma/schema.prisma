// ============================================================================
// CALCULADORA ÓTICA
// ----------------------------------------------------------------------------
// FASE 2 — implementado, ligado com AUTH_MODO=banco (padrão continua "mock",
// ver src/lib/dadosMock.js, para quem só quer testar sem banco). Mesma
// receita do AtendimentoLocaPronto: MySQL da própria Hostinger, engineType
// "client" + driver adapter, sem motor Rust — ver o schema.prisma daquele
// projeto para o porquê completo.
//
// Multi-tenant, mas sem hierarquia: cada acesso vendido é uma Empresa com
// exatamente um Usuario — não há convite de equipe nem papel dentro da
// mesma conta (ver dadosMock.js). Empresa existe separada de Usuario porque
// `status` (trial/ativo/inadimplente/cancelado) é o que o webhook de
// pagamento da Fase 3 muda, e essa marcação não deveria virar coluna solta
// em Usuario.
// ============================================================================

generator client {
  provider   = "prisma-client-js"
  // driverAdapters não é mais preview feature nesta versão do Prisma — só
  // "client" precisa ser dito explicitamente (sem isso, o binário Rust
  // continua sendo baixado mesmo com adapter configurado).
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Ciclo de vida do acesso vendido. `trial` nasce da primeira compra ou de um
/// convite manual; os demais valores acompanham o webhook do meio de
/// pagamento escolhido (ver README, seção "Próximas fases").
enum StatusEmpresa {
  trial
  ativo
  inadimplente
  cancelado
}

/// Uma ótica cliente do sistema — o "tenant". Nasce quando alguém compra o
/// acesso (Fase 2: webhook do pagamento cria o registro e o usuário, e manda
/// o e-mail de acesso).
model Empresa {
  id        String        @id @default(uuid())
  nome      String
  status    StatusEmpresa @default(trial)
  /// Custos padrão da calculadora de margem (CMV de lente, taxa da
  /// maquininha por parcela, comissão etc.) — JSON porque o formato já é
  /// livre no repositório mock (ver src/lib/repositorioConfiguracoes.js) e
  /// não há consulta que precise indexar campo por campo aqui dentro.
  configuracaoCustos Json?
  /// Id da assinatura (`preapproval`) no Mercado Pago que criou esta conta —
  /// é por ele que o webhook reconhece "essa cobrança é desta empresa" nos
  /// eventos seguintes (pagamento aprovado, atrasado, cancelado). Nulo para
  /// contas criadas na mão (seed, convite manual).
  mercadoPagoAssinaturaId String? @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  usuarios Usuario[]

  @@map("empresas")
}

/// O login do acesso vendido. Um por Empresa — não é "equipe", é a conta.
model Usuario {
  id              String    @id @default(uuid())
  empresaId       String
  nome            String
  email           String    @unique
  senhaHash       String
  senhaAlteradaEm DateTime?
  ativo           Boolean   @default(true)
  ultimoLogin     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("usuarios")
}
