# ============================================================================
# CALCULADORA ÓTICA — variáveis de ambiente
# Copie para .env e preencha. Nunca versione o .env.
# ============================================================================

# --- Ambiente ---
NODE_ENV=production
# Porta única: o Express serve a API e o front buildado.
# 3335, e não 3334/3333, para conviver com o AtendimentoLocaPronto e o painel
# financeiro na mesma máquina (Hostinger, mesmo servidor).
#
# Na hospedagem Node.js da Hostinger, NÃO defina PORT: a plataforma injeta a
# dela, e fixar um valor faria a aplicação escutar numa porta que ninguém está
# ouvindo. Esta linha vale para desenvolvimento e para VPS.
PORT=3335
TZ=America/Sao_Paulo

# --- Autenticação ---
# "mock": login e custos padrão vivem em memória (sem banco) — para testar
# sem depender de nada externo. "banco": Prisma + MySQL de verdade (ver
# seção FASE 2 abaixo, que precisa estar preenchida se usar este modo).
AUTH_MODO=mock

# Gere com: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN=7d

# --- CORS ---
# Em produção o front é servido pelo próprio Express (mesma origem), então
# pode ficar vazio. Em desenvolvimento, libere o Vite.
CORS_ORIGINS="http://localhost:5175"

# --- Front estático ---
WEB_DIST_DIR=./web/dist

# --- Log ---
# debug | info | warn | error
LOG_LEVEL=info

# ============================================================================
# FASE 2 — banco de dados (só usado com AUTH_MODO=banco)
# ============================================================================
# Mesmo esquema do AtendimentoLocaPronto: MySQL da própria Hostinger, banco
# PRÓPRIO (não reaproveitar o de outro sistema), host não é "localhost" —
# segue o padrão auth-dbNNNN.hstgr.io (a barra de endereço do phpMyAdmin, pelo
# hPanel, mostra qual é). Detalhes completos de como montar essa URL
# (incluindo o percent-encoding de senha com caractere especial) estão no
# README do AtendimentoLocaPronto — mesmo procedimento, outro banco.
# DATABASE_URL="mysql://u000000000_usuario:SENHA@auth-dbNNNN.hstgr.io:3306/u000000000_banco"
DB_MAX_CONEXOES=3
MIGRAR_NO_BOOT=true
CHECKPOINT_DISABLE=1

# Primeira conta, criada pelo seed quando o banco está vazio (ver
# prisma/seed.js). Trocar isto depois do primeiro boot NÃO muda a senha de
# quem já está usando — para trocar, é preciso mexer direto no banco (ainda
# não há tela de "esqueci minha senha").
EMPRESA_NOME="Minha Ótica"
ADMIN_NOME="Seu Nome"
ADMIN_EMAIL="seu@email.com"
ADMIN_SENHA="troque-esta-senha-no-primeiro-acesso"

# ============================================================================
# FASE 3 — venda de acesso (Mercado Pago + Resend)
# ============================================================================
# Ou preenche as quatro de pagamento juntas, ou deixa todas vazias — pela
# metade, /pagamentos/assinar responde erro em vez de meio-funcionar (ver
# src/config/env.js#pagamentoConfigurado).

# URL pública desta aplicação, SEM barra no fim. Em produção é o domínio de
# verdade (ex.: https://calculadora.gmtacademy.com.br); em desenvolvimento,
# o preview/túnel que estiver ativo no momento. Usada para montar o back_url
# do checkout e o link "Entrar na calculadora" no e-mail de acesso.
URL_BASE=""

# Painel do Mercado Pago > Suas integrações > (a aplicação) > Credenciais de
# produção/teste. TEST-... em teste, APP_USR-... em produção — confundir os
# dois manda o link de checkout errado (sandbox vs. real).
MERCADOPAGO_ACCESS_TOKEN=""

# Painel do Mercado Pago > Suas integrações > (a aplicação) > Webhooks >
# configure a URL "<URL_BASE>/api/v1/pagamentos/webhook" primeiro — o
# segredo só aparece depois disso. Confere que a notificação de pagamento
# realmente veio do Mercado Pago (assinatura HMAC no header x-signature).
MERCADOPAGO_WEBHOOK_SECRET=""

# Valor mensal da assinatura, em reais.
PRECO_ASSINATURA=49.00

# resend.com — API key da conta, e remetente já verificado (SPF/DKIM) lá.
# EMAIL_REMETENTE é específico DESTE produto: cada produto da empresa manda
# do seu próprio remetente, nunca de um endereço genérico compartilhado.
RESEND_API_KEY=""
EMAIL_REMETENTE="calculadora@gmtacademy.com.br"
