# ============================================================================
# CALCULADORA ÓTICA — variáveis de ambiente
# Copie para .env e preencha. Nunca versione o .env.
# ============================================================================

# --- Ambiente ---
NODE_ENV=production
# Porta única: o Express serve a API e o front buildado.
# 3335, e não 3334/3333, para conviver com o AtendimentoLocaPronto e o painel
# financeiro na mesma máquina (Hostinger, mesmo servidor).
#
# Na hospedagem Node.js da Hostinger, NÃO defina PORT: a plataforma injeta a
# dela, e fixar um valor faria a aplicação escutar numa porta que ninguém está
# ouvindo. Esta linha vale para desenvolvimento e para VPS.
PORT=3335
TZ=America/Sao_Paulo

# --- Autenticação ---
# FASE ATUAL: mock. Login e cadastro de usuários vivem em memória
# (src/lib/repositorioUsuarios.js) — sem banco, sem pagamento, só para
# validar o produto. Ver src/lib/dadosMock.js para editar quem entra.
# Quando o banco e o pagamento estiverem prontos, troca para "banco" (ver
# README, seção "Próximas fases").
AUTH_MODO=mock

# Gere com: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN=7d

# --- CORS ---
# Em produção o front é servido pelo próprio Express (mesma origem), então
# pode ficar vazio. Em desenvolvimento, libere o Vite.
CORS_ORIGINS="http://localhost:5175"

# --- Front estático ---
WEB_DIST_DIR=./web/dist

# --- Log ---
# debug | info | warn | error
LOG_LEVEL=info

# ============================================================================
# FASE 2 — banco de dados (ainda não usado com AUTH_MODO=mock)
# ============================================================================
# Mesmo esquema do AtendimentoLocaPronto: MySQL da própria Hostinger, banco
# PRÓPRIO (não reaproveitar o de outro sistema), host não é "localhost" —
# segue o padrão auth-dbNNNN.hstgr.io. Detalhes completos de como montar essa
# URL (incluindo o percent-encoding de senha com caractere especial) estão no
# README do AtendimentoLocaPronto — mesmo procedimento, outro banco.
# DATABASE_URL="mysql://u000000000_usuario:SENHA@auth-dbNNNN.hstgr.io:3306/u000000000_banco"
# DB_MAX_CONEXOES=3
# MIGRAR_NO_BOOT=true
# CHECKPOINT_DISABLE=1

# ============================================================================
# FASE 2 — pagamento (venda de acesso a outras óticas, ainda não integrado)
# ============================================================================
# Webhook de compra aprovada -> cria a Empresa e o primeiro usuário, manda
# e-mail de acesso. Provedor a decidir (ver README).
# PAGAMENTO_WEBHOOK_SECRET=""
